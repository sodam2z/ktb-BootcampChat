# 프로덕션 빌드용 환경 변수 템플릿.
# `pnpm run build:production` 전에 이 파일을 .env.production 으로 복사한 뒤
# 배포 대상 주소로 값을 고치세요. (.env.production 은 커밋하지 않습니다)
NEXT_PUBLIC_API_URL=http://localhost:5001
NEXT_PUBLIC_SOCKET_URL=http://localhost:5002
NEXT_PUBLIC_PROFILE_IMAGE_RESIZE_ENABLED=false
NEXT_PUBLIC_PROFILE_DIRECT_UPLOAD_ENABLED=true
NEXT_PUBLIC_CHAT_DIRECT_UPLOAD_ENABLED=false
